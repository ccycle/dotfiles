// Tailscale ACL policy — default-deny, grant access per role.
//
// Apply with: scripts/tailscale-acl-apply.sh (see the tailscale-acl-apply skill).
// See modules/tailscale/design.md for the zero-trust roadmap.
{
  // --- Tag ownership ---
  // Tags let us assign roles to devices independently of user identity.
  "tagOwners": {
    "tag:server": ["autogroup:admin"],
    "tag:client": ["autogroup:admin"],
  },

  // --- ACLs: default-deny, explicit grants ---
  "acls": [
    // Client devices (the owner's own) may reach any port on a
    // tag:server device. See design.md, "Why Client→Server Access Is
    // Fully Open, But Server→Server Isn't" — this is a single-user
    // tailnet, so there's no third party to isolate tag:server from.
    // Backend ports that stay 127.0.0.1-bound (1234, 2283, 3000, 8929,
    // 9090, 9200 on hosts this repo manages) remain unreachable
    // regardless, since bind address is the actual defense there.
    {
      "action": "accept",
      "src":    ["autogroup:member"],
      "dst":    ["tag:server:*"],
    },

    // Allow servers to reach each other for cross-host services
    // (e.g. monitoring scraping, replication).
    {
      "action": "accept",
      "src":    ["tag:server"],
      "dst":    ["tag:server:80,443,53"],
    },
  ],

  // --- SSH policy (Tailscale SSH, optional) ---
  "ssh": [
    {
      "action": "check",
      "src":    ["autogroup:member"],
      "dst":    ["tag:server"],
      "users":  ["autogroup:nonroot"],
    },
  ],

  // --- Node attributes ---
  "nodeAttrs": [
    {
      // Disable key expiry on servers so they don't go offline unattended.
      "target": ["tag:server"],
      "attr":   ["funnel:off"],
    },
  ],
}
