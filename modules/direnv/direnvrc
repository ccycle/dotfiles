# 目的:
# direnv経由で1Password CLI (op) を使用する際、ディレクトリの移動（cd）や
# direnv reloadのたびに生じる頻繁な認証の要求（Touch IDやパスワード入力など）を抑制する。
#
# 実装方針:
# 1. direnv が .envrc を評価する前に読み込まれる ~/.config/direnv/direnvrc の特性を利用し、
#    op コマンドのラッパー関数を定義して .envrc 内の op 呼び出しを透過的にフックする。
# 2. `op read` コマンドが呼ばれた時のみフックし、それ以外のコマンドはオリジナルの op コマンドへ処理を委譲する。
# 3. 取得したシークレットはリクエストURI（op://...）のハッシュをキーとして ~/.cache/op-direnv/ に保存する。
#    （他ユーザーから見えないようにパーミッションを厳格に設定）
# 4. 一定時間（TTL、デフォルト8時間）内はキャッシュから値を返し、期限切れの場合のみ実際に op コマンドを実行してキャッシュを更新する。

op() {
  # `op read` 以外のコマンドはそのまま実行
  if [[ "$1" != "read" ]]; then
    command op "$@"
    return
  fi

  # キャッシュディレクトリの準備 (安全のためパーミッションを700に設定)
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/op-direnv"
  mkdir -p "$cache_dir"
  chmod 700 "$cache_dir"

  # 引数からキャッシュキー(SHA256またはMD5ハッシュ)を生成
  local uri="${@: -1}"
  local cache_key
  if command -v shasum >/dev/null 2>&1; then
    cache_key=$(echo -n "$uri" | shasum -a 256 | awk '{print $1}')
  else
    cache_key=$(echo -n "$uri" | md5)
  fi

  local cache_file="$cache_dir/$cache_key"
  local ttl=28800 # キャッシュの有効期間（秒）: 8時間 = 28800
  local now
  now=$(date +%s)

  # キャッシュが存在し、かつ有効期限内の場合はキャッシュを返す
  if [[ -f "$cache_file" ]]; then
    # macOS/Linux(GNU) 両対応のファイル更新時刻取得
    local mtime
    mtime=$(date -r "$cache_file" +%s 2>/dev/null)

    if [[ -n "$mtime" ]] && (( now - mtime < ttl )); then
      cat "$cache_file"
      return 0
    fi
  fi

  # キャッシュがない、または期限切れの場合は実際に `op read` を実行
  local result
  result=$(command op "$@")
  local exit_code=$?

  # 実行に成功した場合は結果をキャッシュファイルに保存
  if [[ $exit_code -eq 0 && -n "$result" ]]; then
    echo "$result" > "$cache_file"
    chmod 600 "$cache_file"
    echo "$result"
  else
    return $exit_code
  fi
}
