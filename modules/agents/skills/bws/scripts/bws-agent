#!/usr/bin/env bash
# Run bws as the agent's machine account without exposing secret values.
# The token is fetched from rbw on every call and exported only to bws, so the
# agent's command line never contains `rbw get` (which the permission rules ask
# about) and the token never reaches the agent's environment.
set -euo pipefail

token_item=bws-agent-token

die() {
  echo "bws-agent: $*" >&2
  exit 2
}

usage() {
  die "usage: bws-agent project list | keys <project-id> | run <project-id> -- <command>"
}

# Validate arguments before touching rbw, so refused calls never fetch the token.
login() {
  BWS_ACCESS_TOKEN="$(rbw get "$token_item")" || die "rbw get $token_item failed; is rbw unlocked?"
  export BWS_ACCESS_TOKEN
}

case "${1:-}" in
project)
  [ "${2:-}" = list ] || usage
  login
  bws project list --output table
  ;;
keys)
  [ $# -eq 2 ] || usage
  login
  # Values pass through the pipe into jq only; nothing but key names is printed.
  bws secret list "$2" --output json | jq -r '.[].key'
  ;;
run)
  [ $# -ge 4 ] && [ "$3" = -- ] || usage
  project="$2"
  shift 3
  login
  # Every value in the project is redacted from the command's stdout and stderr.
  # The values reach jq over fd 3, not argv or env, so `ps` never shows them.
  # One-argument split matches literally, so values need no regex escaping;
  # longest first, so a value containing another is masked whole.
  # ponytail: line-based literal match; a value split across lines or transformed
  # (base64, hex, sliced) is not caught, and invalid UTF-8 in the output becomes
  # U+FFFD. Upgrade to a byte-level streaming matcher if either matters.
  bws run --project-id "$project" -- "$@" 2>&1 |
    jq -Rr --unbuffered --slurpfile v /dev/fd/3 \
      'reduce $v[0][] as $s (.; split($s) | join("[REDACTED]"))' \
      3< <(bws secret list "$project" --output json | jq '[.[].value | select(length > 0)] | sort_by(-length)')
  ;;
*)
  # secret get/list and every other subcommand print values or mutate state.
  usage
  ;;
esac
