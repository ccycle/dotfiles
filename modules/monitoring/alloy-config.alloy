// Docker container log discovery
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.extract_level.receiver]
}

// Host log files
local.file_match "host_logs" {
  path_targets = [
    {__path__ = "/var/log/host/*.log", source = "host"},
  ]
}

loki.source.file "host_logs" {
  targets    = local.file_match.host_logs.targets
  forward_to = [loki.process.extract_level.receiver]
}

// GitLab file logs. GitLab Omnibus writes its real logs (rails, sidekiq,
// gitaly, nginx, ...) to /var/log/gitlab inside the container — mounted on
// the host and remounted here — not to the container's stdout, so the docker
// source above never sees them. `compose_project=gitlab` is set statically so
// one selector covers both stdout and file logs.
local.file_match "gitlab_logs" {
  path_targets = [
    {__path__ = "/var/log/gitlab-host/**/*.log", source = "gitlab-file", compose_project = "gitlab"},
    {__path__ = "/var/log/gitlab-host/**/current", source = "gitlab-file", compose_project = "gitlab"},
  ]
}

// Subdirectory name = GitLab component (gitlab-rails, sidekiq, gitaly, ...)
discovery.relabel "gitlab_logs" {
  targets = local.file_match.gitlab_logs.targets

  rule {
    source_labels = ["__path__"]
    regex         = "/var/log/gitlab-host/([^/]+)/.*"
    target_label  = "gitlab_component"
  }
}

loki.source.file "gitlab_logs" {
  targets    = discovery.relabel.gitlab_logs.output
  forward_to = [loki.process.extract_level.receiver]
}

// Extract a normalized `level` label from JSON logs so LogQL can filter
// errors cheaply ({level="error"}). Non-JSON lines pass through unlabeled.
// GitLab rails logs use `severity` instead of `level`.
loki.process "extract_level" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level    = "level",
      severity = "severity",
      vhost    = "request.host",
    }
  }

  stage.template {
    source   = "level"
    template = "{{ if .level }}{{ .level }}{{ else if .severity }}{{ .severity }}{{ end }}"
  }

  stage.template {
    source   = "level"
    template = "{{ ToLower .Value }}"
  }

  // Caddy's access-log `request.host` includes the port (e.g.
  // "opencloud.host.internal:443"); strip it since every vhost shares the
  // same port, so the suffix adds no distinguishing information.
  stage.template {
    source   = "vhost"
    template = "{{ regexReplaceAll `:[0-9]+$` .Value `` }}"
  }

  stage.labels {
    values = {
      level = "",
      vhost = "",
    }
  }
}

// Send logs to Loki
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// OTLP trace receiver, forwarding straight to Tempo. Alloy stays the one
// collector entry point for both logs and traces, same role it already
// plays for logs above. No instrumented service sends traces yet — this
// is the receiving end only, so it can be confirmed working (e.g. with a
// manually-sent test span) before any app is wired to it. Caddy is the
// intended first trace source, but its OTel support is unverified as of
// this writing (see design.md), so it isn't configured here.
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}
