{
  "title": "OpenCloud Health",
  "uid": "opencloud-health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporters up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"opencloud\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Proxy requests vs errors",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (rate(opencloud_proxy_requests_total{job=\"opencloud\"}[5m]))",
          "legendFormat": "requests: {{method}}"
        },
        {
          "refId": "B",
          "expr": "sum by (method) (rate(opencloud_proxy_errors_total{job=\"opencloud\"}[5m]))",
          "legendFormat": "errors: {{method}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Proxy request duration p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(opencloud_proxy_duration_seconds_bucket{job=\"opencloud\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active uploads / downloads (reva)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "reva_upload_active{job=\"opencloud\"}",
          "legendFormat": "uploads"
        },
        {
          "refId": "B",
          "expr": "reva_download_active{job=\"opencloud\"}",
          "legendFormat": "downloads"
        }
      ]
    }
  ]
}
