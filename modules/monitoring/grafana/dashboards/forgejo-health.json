{
  "title": "Forgejo Health",
  "uid": "forgejo-health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporters up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"forgejo\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Instance statistics",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "gitea_repositories{job=\"forgejo\"}",
          "legendFormat": "repositories",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "gitea_users{job=\"forgejo\"}",
          "legendFormat": "users",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "gitea_issues_open{job=\"forgejo\"}",
          "legendFormat": "issues open",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "gitea_issues_closed{job=\"forgejo\"}",
          "legendFormat": "issues closed",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Issues by label",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gitea_issues_by_label{job=\"forgejo\"}",
          "legendFormat": "{{label}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Issues by repository",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gitea_issues_by_repository{job=\"forgejo\"}",
          "legendFormat": "{{repository}}",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Process resident memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"forgejo\"}",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Go goroutines",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{job=\"forgejo\"}",
          "legendFormat": "goroutines"
        }
      ]
    }
  ]
}
