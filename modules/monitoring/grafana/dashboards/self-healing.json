{
  "title": "Self-Healing",
  "uid": "self-healing",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Decisions by action",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (count_over_time(({source=\"host\"} | json | component=\"self-healing\")[1d]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Executed actions that failed verification (7d)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time(({source=\"host\"} | json | component=\"self-healing\" | verified=`false`)[7d]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Heartbeat (last completed run)",
      "description": "self_healing_last_run_timestamp_seconds, written on every run (poll- or webhook-triggered). Stale here means the daemon itself stopped running, not that nothing fired - see SelfHealingHeartbeatMissing in prometheus-rules.yml.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "dateTimeFromNow" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "self_healing_last_run_timestamp_seconds * 1000",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Heartbeat missing",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertname=\"SelfHealingHeartbeatMissing\"}",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Self-healing decisions (newest first)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 7 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{source=\"host\"} | json | component=\"self-healing\" | line_format \"{{.ts}} [{{.mode}}] {{.alert}} -> {{.action}} {{.target_service}} (executed={{.executed}} verified={{.verified}})\""
        }
      ]
    }
  ]
}
