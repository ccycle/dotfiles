{
  "title": "Logs Explorer",
  "uid": "logs-explorer",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "compose_project",
        "label": "Compose project",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(compose_project)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log volume by service",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_service) (count_over_time({compose_project=~\"$compose_project\"}[5m]))",
          "legendFormat": "{{compose_service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error volume by project (level label)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (compose_project) (count_over_time({compose_project=~\"$compose_project\", level=~\"error|fatal|panic\"}[5m]))",
          "legendFormat": "{{compose_project}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Errors",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_project=~\"$compose_project\"} |~ \"(?i)(error|fatal|panic)\""
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "All logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "expr": "{compose_project=~\"$compose_project\"}"
        }
      ]
    }
  ]
}
