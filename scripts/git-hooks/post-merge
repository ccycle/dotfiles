#!/usr/bin/env sh
# Remove herdr worktrees for branches merged to main.
# Runs after git merge / git pull completes on main.
# Worktrees that were never started (branch reflog shows only the
# initial creation) are excluded from removal.

set -eu

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$branch" != "main" ]; then
    exit 0
fi

command -v herdr >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# Return 0 if the branch has ever been worked on (reflog contains
# commit/rebase/merge/reset entries), 1 if never started (only the
# initial creation entry) or if no reflog is available.
branch_was_started() {
    branch="$1"
    entries=$(git reflog show --format="%gs" "$branch" 2>/dev/null) || return 1
    [ -z "$entries" ] && return 1
    active=$(printf '%s\n' "$entries" \
        | grep -vE '^(branch: Created from|checkout:|rebase \(start\))' \
        | wc -l | tr -d ' ')
    [ "$active" -gt 0 ]
}

herdr worktree list --json 2>/dev/null | jq -r '
  .result.worktrees[]
  | select(.branch != "main")
  | "\(.branch)\t\(.open_workspace_id)\t\(.path)"
' 2>/dev/null | while IFS='	' read -r ws_branch ws_id ws_path || [ -n "$ws_branch" ]; do
    if git merge-base --is-ancestor "$ws_branch" main 2>/dev/null \
        && branch_was_started "$ws_branch" \
        && [ -z "$(git -C "$ws_path" status --porcelain 2>/dev/null)" ]; then
        herdr worktree remove --workspace "$ws_id" --json 2>/dev/null || true
    fi
done
