#!/usr/bin/env sh
# Block direct commits to the main branch to avoid cross-device conflicts.
# Bypass: ALLOW_MAIN_COMMIT=1 git commit ...  (or git commit --no-verify)

set -eu

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

if [ "$branch" = "main" ]; then
    if [ "${ALLOW_MAIN_COMMIT:-0}" = "1" ]; then
        exit 0
    fi
    printf '\033[31mRefusing to commit directly to main.\033[0m\n' >&2
    printf 'Create a feature branch first:\n' >&2
    printf '  git switch -c <branch-name>\n\n' >&2
    printf 'To bypass (emergency only): ALLOW_MAIN_COMMIT=1 git commit ...\n' >&2
    exit 1
fi
