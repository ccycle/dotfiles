#!/usr/bin/env sh
# Local main may only move to the commit refs/remotes/origin/main points at.
# main is integrated only through Forgejo pull requests, so this rejects direct
# commits, all merges (including fast-forward, which never runs pre-commit or
# pre-merge-commit), rebases, cherry-picks, and branch -f, while still allowing
# `git pull --ff-only origin main` and `git fetch` + `git reset --keep origin/main`.
#
# Chosen as a single mechanism over per-command hooks: reference-transaction
# sees every ref update, so one invariant covers all commands. It is repo-local
# (hooksPath points here), so other repositories are unaffected.
#
# Work on a branch and open a Forgejo PR instead.

set -eu

# Runs for preparing/committed/aborted too; only the locked "prepared" state
# may reject the transaction.
[ "${1:-}" = "prepared" ] || exit 0

origin_main=$(git rev-parse --verify --quiet refs/remotes/origin/main || true)

blocked=0
while read -r _old new ref; do
    [ "$ref" = "refs/heads/main" ] || continue
    # A missing origin/main or any value other than it (including a deletion,
    # whose new value is all zeroes) is not a fast-forward from origin.
    if [ -z "$origin_main" ] || [ "$new" != "$origin_main" ]; then
        blocked=1
    fi
done

if [ "$blocked" = "1" ]; then
    printf '\033[31mRefusing to move local main away from origin/main.\033[0m\n' >&2
    printf 'main is integrated only through Forgejo pull requests.\n' >&2
    printf 'Create a branch and open a PR instead:\n' >&2
    printf '  git switch -c <branch-name>\n' >&2
    printf '  git push origin <branch-name>\n' >&2
    printf '\nTo catch up with origin without changing history:\n' >&2
    printf '  git pull --ff-only origin main\n' >&2
    exit 1
fi
