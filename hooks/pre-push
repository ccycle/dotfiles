#!/usr/bin/env sh
set -eu

remote="$1"
status=0
while read -r _local_ref _local_oid remote_ref _remote_oid; do
  if [ "$remote_ref" = refs/heads/main ]; then
    printf '\033[31mRefusing to push to main on %s.\033[0m\n' "$remote" >&2
    printf 'main changes only through a merged Forgejo PR: push a branch and open a PR instead.\n' >&2
    status=1
  fi
done
exit "$status"
